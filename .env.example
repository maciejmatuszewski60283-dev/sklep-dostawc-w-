# =============================================================
#  najtańsze itemki — zmienne środowiskowe
#  Skopiuj ten plik jako .env i uzupełnij. NIGDY nie wrzucaj .env do repozytorium.
#  Sekrety wygenerujesz poleceniem:  npm run secrets:generate
# =============================================================

# Środowisko: development | test | production
NODE_ENV=development

# Port, na którym nasłuchuje aplikacja (za reverse proxy / Cloudflare Tunnel)
PORT=3000

# Publiczny adres sklepu BEZ ukośnika na końcu.
# Lokalnie: http://localhost:3000 — po zakupie domeny: https://twojadomena.pl
PUBLIC_URL=http://localhost:3000

# Ścieżka panelu administratora. Zmień na trudną do odgadnięcia, np. /panel-k7x2q
ADMIN_PATH=/admin

# Klucz do podpisywania ciasteczek i tokenów (min. 32 znaki losowe)
SESSION_SECRET=

# Klucz szyfrujący dane wrażliwe w bazie (klucze produktów, hasło SMTP, klucze API).
# 64 znaki hex (32 bajty). UTRATA TEGO KLUCZA = utrata dostępu do zaszyfrowanych danych.
# Przechowuj jego kopię w menedżerze haseł, osobno od kopii zapasowych bazy.
ENCRYPTION_KEY=

# Katalog na bazę danych, zdjęcia i pliki do dostawy
DATA_DIR=./data

# Ile serwerów proxy stoi przed aplikacją (Cloudflare Tunnel = 1, Cloudflare + Caddy = 2).
# Potrzebne do poprawnego odczytu IP klienta przy limitach żądań.
TRUST_PROXY=0

# Maksymalny rozmiar pliku do automatycznej dostawy (MB)
MAX_DELIVERY_FILE_MB=100
