</main>
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="/" class="logo"><span class="logo-mark"><%- include('icon', { name: 'tag' }) %></span><span><%= shop.name.split(' ')[0] %> <em><%= shop.name.split(' ').slice(1).join(' ') %></em></span></a>
        <p class="footer-tagline"><%= shop.tagline %></p>
        <% if (typeof acceptedAssets !== 'undefined' && acceptedAssets.length) { %>
          <div class="coins" aria-label="Akceptowane kryptowaluty">
            <% [...new Map(acceptedAssets.map(a => [a.symbol, a])).values()].forEach(function (a) { %><span class="coin"><span class="coin-ic <%= a.icon %>"><%= a.symbol.slice(0, 4) %></span><%= a.symbol %></span><% }) %>
          </div>
        <% } %>
      </div>
      <div>
        <h4>Sklep</h4>
        <ul>
          <li><a href="/produkty">Wszystkie produkty</a></li>
          <li><a href="/koszyk">Koszyk</a></li>
          <li><a href="/zamowienie">Znajdź zamówienie</a></li>
        </ul>
      </div>
      <div>
        <h4>Informacje</h4>
        <ul>
          <% (typeof footerPages !== 'undefined' ? footerPages : []).forEach(function (p) { %><li><a href="/strona/<%= p.slug %>"><%= p.title %></a></li><% }) %>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© <%= new Date().getFullYear() %> <%= shop.name %>. Płatności wyłącznie w kryptowalutach.</span>
      <% if (shop.contactEmail) { %><a href="mailto:<%= shop.contactEmail %>"><%= shop.contactEmail %></a><% } %>
    </div>
  </div>
</footer>
</body>
</html>
