<%- include('_head') %>
<div class="content-head"><h1>Produkty</h1><a class="btn btn-primary" href="<%= A %>/produkty/nowy">+ Dodaj produkt</a></div>
<form class="filters-bar" method="get">
  <input class="input grow" name="q" value="<%= q %>" placeholder="Szukaj po nazwie…">
  <select class="select" name="status"><option value="">Wszystkie</option><option value="active" <%= status === 'active' ? 'selected' : '' %>>Opublikowane</option><option value="hidden" <%= status === 'hidden' ? 'selected' : '' %>>Ukryte</option></select>
  <button class="btn btn-secondary btn-sm" type="submit">Filtruj</button>
</form>
<div class="table-wrap">
  <table class="t">
    <thead><tr><th></th><th>Nazwa</th><th>Platforma</th><th>Cena od</th><th>Dostawa</th><th>Stan</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% rows.forEach(function (p) { %>
      <tr>
        <td><div class="thumb"><% if (p.thumb) { %><img src="/media/<%= p.thumb %>" alt=""><% } %></div></td>
        <td><a class="strong" href="<%= A %>/produkty/<%= p.id %>"><%= p.name %></a><div class="muted small"><%= p.category_name || 'bez kategorii' %> · <%= p.variant_count %> wariant(y)</div></td>
        <td><%= p.platform_name || '—' %></td>
        <td><%= p.min_price != null ? fmt(p.min_price) : '—' %></td>
        <td><%= { keys: 'Klucze', file: 'Plik', manual: 'Ręczna' }[p.delivery_type] %></td>
        <td><% if (p.delivery_type === 'keys') { %><span class="pill <%= p.stock === 0 ? 'bad' : p.stock < 5 ? 'warn' : 'ok' %>"><%= p.stock %></span><% } else { %><span class="muted">—</span><% } %></td>
        <td><span class="pill <%= p.active ? 'ok' : 'muted' %>"><%= p.active ? 'Opublikowany' : 'Ukryty' %></span><% if (p.featured) { %> <span class="pill info">Polecany</span><% } %></td>
        <td>
          <div class="actions">
            <% if (p.active) { %><a class="btn btn-ghost btn-sm" href="/produkt/<%= p.slug %>" target="_blank" rel="noopener">Podgląd</a><% } %>
            <form method="post" action="<%= A %>/produkty/<%= p.id %>/widocznosc"><input type="hidden" name="_csrf" value="<%= csrfToken() %>"><button class="btn btn-secondary btn-sm" type="submit"><%= p.active ? 'Ukryj' : 'Opublikuj' %></button></form>
            <a class="btn btn-secondary btn-sm" href="<%= A %>/produkty/<%= p.id %>">Edytuj</a>
          </div>
        </td>
      </tr>
    <% }) %>
    <% if (!rows.length) { %><tr><td colspan="8"><div class="empty"><h3>Brak produktów</h3><p>Dodaj pierwszy produkt — formularz poprowadzi Cię krok po kroku.</p><a class="btn btn-primary" href="<%= A %>/produkty/nowy">+ Dodaj produkt</a></div></td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('_foot') %>
